{
  "application": "pulse",
  "directory": "pulse",
  "packages": [
    "nyx-pulse",
    "nyx-pulse-glimpse"
  ],
  "manifest": "Cargo.toml",
  "prepare": [
    [
      "bash",
      "apps/pulse/packaging/prepare-native.sh"
    ]
  ],
  "binaries": [],
  "test_commands": [
    [
      "cargo",
      "test",
      "--locked",
      "-p",
      "nyx-pulse",
      "--bin",
      "nyx-pulse",
      "--",
      "--skip",
      "ui_regression"
    ],
    [
      "bash",
      "-c",
      "gtk4-broadwayd :7 & broadway=$!; sleep 2; GDK_BACKEND=broadway BROADWAY_DISPLAY=:7 cargo test --locked -p nyx-pulse --bin nyx-pulse ui_regression; status=$?; kill $broadway; exit $status"
    ]
  ]
}
